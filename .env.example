# =====================================================================
# VARIÁVEIS DE AMBIENTE - CINEPATTERN (REACT NATIVE + VITE + FIREBASE)
# =====================================================================

# 🎬 Chave de API da TMDb (The Movie Database)
# Obtenha gratuitamente em: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=INSIRA_SEU_TMDB_TOKEN_OU_API_KEY_AQUI

# 🔥 Credenciais do Projeto Firebase
# Obtenha em: https://console.firebase.google.com/ (Configurações do Projeto > Geral > Seus aplicativos Web)
VITE_FIREBASE_API_KEY=AIzaSy_SUA_FIREBASE_API_KEY_AQUI
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# (Compatibilidade opcional para Expo Mobile se desejar rodar no celular também):
EXPO_PUBLIC_TMDB_API_KEY=INSIRA_SEU_TMDB_TOKEN_OU_API_KEY_AQUI
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy_SUA_FIREBASE_API_KEY_AQUI
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
